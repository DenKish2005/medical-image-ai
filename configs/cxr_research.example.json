{
  "manifest": "data/cxr_manifest.csv",
  "image_root": "data/images",
  "diseases": ["Cardiomegaly", "Pleural Effusion", "Pneumothorax"],
  "uncertainty_policy": "ignore",
  "output_dir": "runs/cxr_denseblock2",
  "split": "denseblock2",
  "pretrained_imagenet": false,
  "baseline_checkpoint": "runs/cxr_denseblock2/baseline.pt",
  "codec_checkpoint": "runs/cxr_denseblock2/conditional_codec.pt",
  "seed": 42,
  "image_size": 224,
  "batch_size": 4,
  "num_workers": 0,
  "device": "cpu",
  "baseline_epochs": 2,
  "baseline_lr": 0.0001,
  "codec_epochs": 4,
  "codec_lr": 0.001,
  "latent_channels": 64,
  "rate_fractions": [0.5, 0.25, 0.1, 0.05],
  "eval_modes": ["uniform", "random", "saliency", "uncertainty", "combined"],
  "importance_weight": 0.5,
  "specificity": 0.9,
  "bootstrap_samples": 200,
  "use_roi_loss": false,
  "use_class_weights": false,
  "lesion_weight": 0.0,
  "distill_weight": 0.5,
  "reconstruction_weight": 0.05,
  "rate_weight": 0.000001,
  "over_budget_weight": 0.00001,
  "score_supervision_weight": 0.1
}
